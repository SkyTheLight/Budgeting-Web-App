generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  password     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  transactions Transaction[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]
  chatMessages ChatMessage[]
  billReminders BillReminder[]
  debts        Debt[]
  assets       Asset[]
  recurringRules RecurringRule[]
}

model Transaction {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  type        String
  amount      Decimal   @db.Decimal(14, 2)
  description String?
  category    String
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  category  String
  month     String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  name          String
  targetAmount  Decimal  @db.Decimal(14, 2)
  currentAmount Decimal  @db.Decimal(14, 2) @default(0)
  deadline      DateTime?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model BillReminder {
  id                String    @id @default(cuid())
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  name              String
  amount            Decimal   @db.Decimal(14, 2)
  dueDay            Int       // Day of month (1-31)
  category          String
  isPaid            Boolean   @default(false)
  lastPaid          DateTime?
  paidTransactionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

model Debt {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  name           String
  totalAmount    Decimal  @db.Decimal(14, 2)
  currentAmount  Decimal  @db.Decimal(14, 2)
  interestRate   Float    // Annual interest rate %
  minimumPayment Decimal  @db.Decimal(14, 2)
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Asset {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  name      String
  type      String   // cash, investment, property, vehicle, other
  value     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RecurringRule {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  name         String
  type         String   // income | expense
  category     String
  amount       Decimal  @db.Decimal(14, 2)
  description  String?
  cadence      String   // weekly | monthly
  dayOfWeek    Int?
  dayOfMonth   Int?
  isActive     Boolean  @default(true)
  nextRun      DateTime
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isActive, nextRun])
}