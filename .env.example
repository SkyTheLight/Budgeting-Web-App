# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth secret (use a strong random string)
NEXTAUTH_SECRET="your_nextauth_secret"

# Base URL (adjust if deploying)
NEXTAUTH_URL="http://localhost:3000"

# Public URL used for sitemap/robots/metadata (same as NEXTAUTH_URL when deploying)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: override the demo user created by `prisma db seed`
SEED_EMAIL="demo@budgetpro.app"
SEED_PASSWORD="password123"
SEED_NAME="Demo User"